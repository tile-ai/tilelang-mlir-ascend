+    for _ in range(4):
+        sc("fail", "3", "--dir", str(d2), "--fail-type", "runtime")
+    rc, out = sc("fail", "3", "--dir", str(d2), "--fail-type", "runtime")
+    assert out["failure_reason"] == "BLOCKED_IMPL"
+    state = load_state(d2)
